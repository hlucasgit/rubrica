<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Anclas de confianza IOFE (raíces autofirmadas + TSL de INDECOPI) que
         SecureSign.Trust necesita en tiempo de ejecución — ver
         ConfianzaIofe/README y RUNBOOK.md 12.9 sobre cómo y cuándo refrescarlas. -->
    <Content Include="ConfianzaIofe\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecureSign.Signature.Infrastructure\SecureSign.Signature.Infrastructure.csproj" />
    <ProjectReference Include="..\SecureSign.Signature.Application\SecureSign.Signature.Application.csproj" />
    <ProjectReference Include="..\SecureSign.Signature.Domain\SecureSign.Signature.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\SecureSign.Shared.Auth\SecureSign.Shared.Auth.csproj" />
  </ItemGroup>

</Project>
