<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SecureSignFirmadorLocal</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Metadatos del ejecutable (propiedades de archivo, pestaña "Detalles"). Un binario sin editor, producto ni
         descripción es exactamente lo que las heurísticas de los antivirus puntúan peor — ver RUNBOOK.md 12.37. -->
    <Company>SecureSign</Company>
    <Authors>SecureSign</Authors>
    <Product>SecureSign Firmador Local</Product>
    <AssemblyTitle>SecureSign Firmador Local</AssemblyTitle>
    <Description>Firmador Local de SecureSign: firma documentos con el DNIe u otro token PKCS#11; el PIN nunca sale de este equipo.</Description>
    <Copyright>© 2026 SecureSign</Copyright>
    <NeutralLanguage>es-PE</NeutralLanguage>

    <!-- P1-07 (RUNBOOK.md 12.45): el SDK, por defecto, le agrega su propio sufijo de commit a
         InformationalVersion (SourceRevisionId) aunque el proceso de build ya pase uno explícito
         (Construir-Instalador.ps1 -BuildMetadata) — duplicaría el commit dos veces en la misma cadena.
         Se desactiva para que InformationalVersion sea exactamente "versión+metadato-de-build" y nada más. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pkcs11Interop" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\SecureSign.Pades\SecureSign.Pades.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\SecureSign.Tsa\SecureSign.Tsa.csproj" />
  </ItemGroup>

</Project>
