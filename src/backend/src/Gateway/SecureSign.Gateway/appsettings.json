{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "LimitacionDeTasa": {
    "TokenPorMinuto": 10,
    "InternoPorMinuto": 3000
  },
  "Jwt": {
    "Issuer": "https://api.securesign.pe",
    "Audience": "securesign-platform",
    "InternalAudience": "securesign-internal-services",
    "Authority": "http://gateway:8080",
    "ServiciosEmisores": [
      { "Nombre": "securesign-signature-api", "Secretos": [ "dev-only-secret-signature-api-do-not-use-in-production" ], "PuedeEmitirTickets": true },
      { "Nombre": "securesign-documents-api", "Secretos": [ "dev-only-secret-documents-api-do-not-use-in-production" ] }
    ],
    "DirectorioLlaves": "/app/llaves",
    "MinutosExpiracion": 60,
    "MinutosExpiracionInterno": 2
  },
  "ClientesDemo": {
    "Clientes": [
      {
        "ClientId": "sgd-demo",
        "SecretosHash": [ "$argon2id$v=19$m=19456,t=2,p=1$zz+ZC8QFnPEcCCQGbGuQTg==$kR7K+RueLr/NzwIvesNKbOE4o2kx0JBnaLOxQDj+4vU=" ],
        "TenantId": "11111111-1111-1111-1111-111111111111",
        "ClienteIntegradorId": "22222222-2222-2222-2222-222222222222",
        "Scopes": "documentos.crear documentos.leer firmas.crear firmas.leer evidencias.leer identidad.gestionar"
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "documentos-route": {
        "ClusterId": "documentos-cluster",
        "Match": { "Path": "/api/documentos/{**catch-all}" },
        "AuthorizationPolicy": "requerir-token"
      },
      "firmas-route": {
        "ClusterId": "firmas-cluster",
        "Match": { "Path": "/api/firmas/{**catch-all}" },
        "AuthorizationPolicy": "requerir-token"
      },
      "evidencias-route": {
        "ClusterId": "evidencias-cluster",
        "Match": { "Path": "/api/evidencias/{**catch-all}" },
        "AuthorizationPolicy": "requerir-token"
      },
      "validacion-route": {
        "ClusterId": "firmas-cluster",
        "Match": { "Path": "/api/validacion/{**catch-all}" },
        "AuthorizationPolicy": "publico-sin-auth"
      },
      "validador-route": {
        "ClusterId": "firmas-cluster",
        "Match": { "Path": "/api/validador/{**catch-all}" },
        "AuthorizationPolicy": "publico-sin-auth"
      },
      "identidad-route": {
        "ClusterId": "identidad-cluster",
        "Match": { "Path": "/api/interno/identidad/{**catch-all}" },
        "AuthorizationPolicy": "requerir-token"
      },
      "auditoria-route": {
        "ClusterId": "auditoria-cluster",
        "Match": { "Path": "/api/auditoria/{**catch-all}" },
        "AuthorizationPolicy": "requerir-token"
      }
    },
    "Clusters": {
      "documentos-cluster": {
        "Destinations": { "destino1": { "Address": "http://securesign-documents-api:8080" } }
      },
      "firmas-cluster": {
        "Destinations": { "destino1": { "Address": "http://securesign-signature-api:8080" } }
      },
      "evidencias-cluster": {
        "Destinations": { "destino1": { "Address": "http://securesign-evidence-api:8080" } }
      },
      "identidad-cluster": {
        "Destinations": { "destino1": { "Address": "http://securesign-identity-api:8080" } }
      },
      "auditoria-cluster": {
        "Destinations": { "destino1": { "Address": "http://securesign-audit-api:8080" } }
      }
    }
  }
}
