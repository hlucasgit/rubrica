<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!--
      Overrides de dependencias transitivas de PdfSharpCore 1.3.65 con
      vulnerabilidades HIGH/Moderate conocidas (ver "dotnet list package
      con la opción vulnerable", GHSA-65x7-c272-7g7r y otras). PdfSharpCore
      no las fija con una versión exacta, así que subir la referencia
      directa aquí basta para que toda la cadena (Signature.*, Validator,
      Migrator, tests) resuelva la versión parcheada. Nada en este
      repositorio llama XImage/decodifica imágenes rasterizadas; el
      único consumidor (EstampadorVisualDocumentoPdf) solo dibuja
      rectángulos y texto, así que el salto de versión mayor de
      ImageSharp no tiene superficie de API propia que romper aquí.
      Fijado en la última versión 2.x (Apache 2.0) a propósito: desde
      3.0 Six Labors exige licencia comercial paga (Six Labors Split
      License) para SixLabors.ImageSharp — NO usar 3.x/4.x aquí sin que
      el usuario decida pagar esa licencia. Verificado además con un
      smoke test real del estampado (ver
      tests/SecureSign.UnitTests/Pades/EstampadoVisualTests.cs).
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

</Project>
